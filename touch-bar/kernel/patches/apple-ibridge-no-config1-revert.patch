@@ -539,8 +539,16 @@
 	udev = hid_to_usb_dev(hdev);
 
 	if (udev->actconfig->desc.bConfigurationValue != APPLEIB_BASIC_CONFIG) {
-		rc = usb_driver_set_configuration(udev, APPLEIB_BASIC_CONFIG);
